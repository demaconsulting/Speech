<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Developer tool for the Text.En heteronym model and its training data: check-data verifies
         data/text-en/ (manifest hashes, file format, schema, strict whole-word spans, licenses and
         split separation); train builds and verifies the heteronym model and evaluate measures it.
         Never packed or shipped. The check-data units are BCL only; the training units reference the
         Text.En library (internals visible to this tool) so the model is trained with the analyzer's
         own tokenization, tagging, feature extractor, scoring and model format, not a copy of them. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DemaConsulting.Speech.Text.En.Trainer</RootNamespace>
    <AssemblyName>DemaConsulting.Speech.Text.En.Trainer</AssemblyName>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>

    <!-- Code Quality Configuration (mirrors the ModelDownloader tool) -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- The trainer's internal units are tested directly by its test project. -->
  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.Speech.Text.En.Trainer.Tests" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The library whose internal feature extractor, scorer and model format the trainer reuses. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\DemaConsulting.Speech.Text.En\DemaConsulting.Speech.Text.En.csproj" />
  </ItemGroup>

</Project>
