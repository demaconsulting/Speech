<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Developer tool for the Text.En training data: today only the check-data command, which verifies
         data/text-en/ (manifest hashes, file format, schema, strict whole-word spans, licenses and
         split separation). Never packed or shipped, and independent of the Speech and Text.En runtime
         libraries (BCL only). -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DemaConsulting.Speech.Text.En.Trainer</RootNamespace>
    <AssemblyName>DemaConsulting.Speech.Text.En.Trainer</AssemblyName>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>

    <!-- Code Quality Configuration (mirrors the ModelDownloader tool) -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- The trainer's internal units are tested directly by its test project. -->
  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.Speech.Text.En.Trainer.Tests" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
