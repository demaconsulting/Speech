<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build Configuration -->
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Implicit Usings -->
  <ItemGroup>
    <Using Include="Polyfills" />
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Test Framework Dependencies -->
  <ItemGroup>
    <!-- coverlet.MTP is coverlet's native Microsoft.Testing.Platform extension (the VSTest-only
         coverlet.collector no longer runs under the MTP 'dotnet test' mode required by xunit.v3 4.0.0).
         Child-element form configures both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" keeps this test-coverage tool out of any consuming project's dependencies.
         - IncludeAssets lists all asset types (including 'build' and 'buildtransitive') to ensure the
           extension's MSBuild targets are activated so coverage is collected during test runs. -->
    <PackageReference Include="coverlet.MTP" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>compile; runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <!-- Analyzer packages use child-element form to configure both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" prevents these build-time analyzers from becoming transitive dependencies
           in any project that references this test project.
         - IncludeAssets lists all asset types (including 'analyzers' and 'buildtransitive') to ensure
           Roslyn analyzers and MSBuild targets are fully activated during the build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\DemaConsulting.Speech.Phonemes.En\DemaConsulting.Speech.Phonemes.En.csproj" />
  </ItemGroup>

  <!-- The morphology measurement of the non-shipped tools project is compiled into this test assembly, so the
       measured agreement with the lexicon is also a regression gate here without a test-to-tool reference
       (the tool targets one framework, the tests four). -->
  <ItemGroup>
    <Compile Include="..\..\tools\DemaConsulting.Speech.Phonemes.En.Tools\MorphologySubsystem\MorphologyAudit.cs" Link="Linked\MorphologyAudit.cs" />
    <!-- The golden-corpus machinery of the tools project (pipeline, one-line format, corpus files) is compiled into
         this assembly too, so the regenerate-goldens command and the golden tests cannot disagree. -->
    <Compile Include="..\..\tools\DemaConsulting.Speech.Phonemes.En.Tools\PhonemizerSubsystem\GoldenCorpus.cs" Link="Linked\GoldenCorpus.cs" />
    <!-- The symbol inventories of the two voice models (Piper phoneme_id_map, Kokoro vocabulary) with the same loader
         the tools project uses to write the renderer goldens. -->
    <Compile Include="..\..\tools\DemaConsulting.Speech.Phonemes.En.Tools\PhonemizerSubsystem\SymbolInventory.cs" Link="Linked\SymbolInventory.cs" />
  </ItemGroup>

  <!-- The golden corpora (own-written sentences, CC0) and the data the contract tests check, copied beside the test
       assembly: the reading inventory's form table of the text analysis package, and the committed gap list. -->
  <ItemGroup>
    <None Update="TestData\*.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestData\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\text-en\forms.tsv" Link="TestData\forms.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\phonemes-en\reading-gaps.tsv" Link="TestData\reading-gaps.tsv" CopyToOutputDirectory="PreserveNewest" />
    <!-- Kokoro's own tokenizer vocabulary, linked from the Kokoro package so the vocabulary-coverage test checks the real one. -->
    <None Include="..\..\src\DemaConsulting.Speech.Onnx.Kokoro\Resources\kokoro-v1.0-tokenizer.json" Link="TestData\kokoro-v1.0-tokenizer.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Piper voice's symbol table, linked from the Piper tests' trimmed copy of the real voice configuration (the single committed copy). -->
    <None Include="..\DemaConsulting.Speech.Onnx.Piper.Tests\TestData\en_US-libritts_r-medium.onnx.trimmed.json" Link="TestData\en_US-libritts_r-medium.onnx.trimmed.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
