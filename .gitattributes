# Set default behavior: normalize line endings to LF on checkout for all text files.
# This ensures consistent SHA256 fingerprints for reviewmark across all platforms.
* text=auto eol=lf

# Windows batch files require CRLF line endings to function correctly.
*.bat text eol=crlf
*.cmd text eol=crlf

# The embedded heteronym model is a hash-pinned binary file: never converted or diffed as text.
*.bin binary

# The Text.En training data is verified by SHA-256 (data/text-en/MANIFEST.tsv): always LF, never converted.
data/text-en/** text eol=lf

# The STT evaluation data is verified by SHA-256 (data/stt-en/MANIFEST.tsv): the recordings are binary, never
# converted or diffed as text, and the manifest and notes are always LF.
data/stt-en/**/*.flac binary
data/stt-en/**/*.wav binary
data/stt-en/*.tsv text eol=lf
data/stt-en/*.md text eol=lf
