<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DemaConsulting.Speech.Onnx.Piper</RootNamespace>
    <AssemblyName>DemaConsulting.Speech.Onnx.Piper</AssemblyName>

    <!-- NuGet Package Configuration -->
    <PackageId>DemaConsulting.Speech.Onnx.Piper</PackageId>
    <Version>0.0.0</Version>
    <Authors>DEMA Consulting</Authors>
    <Company>DEMA Consulting</Company>
    <Description>Piper (VITS) LibriTTS-R English text-to-speech model for DemaConsulting.Speech, run
      directly through ONNX Runtime with no bundled native inference engine and no espeak-ng. This
      package owns the full text-to-speech pipeline for this voice itself - English text analysis
      (numbers, dates, abbreviations and heteronym readings, from DemaConsulting.Speech.Text.En),
      phonemization (from the CMU Pronouncing Dictionary, rendered as espeak-style IPA, through
      DemaConsulting.Speech.Phonemes.En), phoneme-id encoding from the voice's own configuration, and
      ONNX Runtime inference - installed into a SpeechModelCatalog via the AddPiperModels() extension
      method. The voice has 904 speakers selected by number. Reference this package alongside
      DemaConsulting.Speech to get this model out of the box; core DemaConsulting.Speech itself ships
      with zero built-in models and has no dependency on ONNX Runtime.</Description>
    <!-- A package carries a license expression or a license file, never both. This package names a
         file because the voice it downloads is under a license other than MIT; see
         PACKAGE-LICENSE.md and THIRD-PARTY-NOTICES.md. -->
    <PackageLicenseFile>PACKAGE-LICENSE.md</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/demaconsulting/Speech</PackageProjectUrl>
    <RepositoryUrl>https://github.com/demaconsulting/Speech</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>speech;speech-to-text;text-to-speech;stt;tts;offline;audio;onnx;onnxruntime;piper;vits</PackageTags>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>DemaConsulting.Speech.Onnx.Piper</Title>
    <Product>DemaConsulting.Speech.Onnx.Piper</Product>

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- SBOM Configuration -->
    <GenerateSBOM>true</GenerateSBOM>
    <SBOMPackageName>$(PackageId)</SBOMPackageName>
    <SBOMPackageVersion>$(Version)</SBOMPackageVersion>
    <SBOMPackageSupplier>Organization: $(Company)</SBOMPackageSupplier>
  </PropertyGroup>

  <!-- Prerelease-only packing (TEMPORARY GUARD, the same as DemaConsulting.Speech.Text.En,
       DemaConsulting.Speech.Phonemes.En and DemaConsulting.Speech.Onnx.Kokoro). This package references
       Text.En and Phonemes.En, and through Text.En the DemaConsulting.PartOfSpeech package, which is
       published only as 0.1.0-beta.N; that dependency flows through to this package's own dependency list.
       A stable package may not depend on a prerelease package (NuGet NU5104), so this project is packable
       only when the package version carries a prerelease label. A stable version skips this project (the
       other packages still pack); a prerelease such as 1.0.0-beta.1 packs it. The effective version is
       PackageVersion when given (as the workflows do) and Version otherwise; SemVer build metadata after '+'
       is ignored, so only a hyphen in the version proper counts. The local default Version of 0.0.0 is
       stable, so a plain local pack skips this project unless a prerelease version is passed.
       REMOVE this guard together with the Text.En, Phonemes.En and Kokoro guards once
       DemaConsulting.PartOfSpeech ships a stable release. -->
  <PropertyGroup>
    <PiperEffectiveVersion>$(Version)</PiperEffectiveVersion>
    <PiperEffectiveVersion Condition="'$(PackageVersion)' != ''">$(PackageVersion)</PiperEffectiveVersion>
    <PiperVersionCore>$(PiperEffectiveVersion.Split('+')[0])</PiperVersionCore>
    <IsPackable>false</IsPackable>
    <IsPackable Condition="$(PiperVersionCore.Contains('-'))">true</IsPackable>
  </PropertyGroup>

  <!-- Build Tool Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.13" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
    <PackageReference Include="DemaConsulting.ApiMark.MSBuild" Version="0.5.12" PrivateAssets="All" />
    <!-- Managed ONNX Runtime API only - see the referenced DemaConsulting.Speech.Onnx package's
         own remarks for why this package never references an accelerated execution-provider
         package itself. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <!-- The BCL has no BZip2 decoder. SharpCompress reads the voice's .tar.bz2 release archive so the
         installer can pick the two files this package uses out of it (PiperArchiveExtractor). The same
         version as DemaConsulting.Speech.Sherpa. -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\DemaConsulting.Speech\DemaConsulting.Speech.csproj" />
    <ProjectReference Include="..\DemaConsulting.Speech.Onnx\DemaConsulting.Speech.Onnx.csproj" />
    <!-- English text analysis (the model's ITextAnalyzer) and English phonemization with the renderer for
         Piper's espeak-style IPA. Phonemes.En already depends on Text.En; the direct reference states that
         this package uses the analyzer itself. -->
    <ProjectReference Include="..\DemaConsulting.Speech.Text.En\DemaConsulting.Speech.Text.En.csproj" />
    <ProjectReference Include="..\DemaConsulting.Speech.Phonemes.En\DemaConsulting.Speech.Phonemes.En.csproj" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <!-- Analyzer packages use child-element form to configure both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" prevents these build-time analyzers from becoming transitive dependencies
           in packages that consume this library.
         - IncludeAssets lists all asset types (including 'analyzers' and 'buildtransitive') to ensure
           Roslyn analyzers and MSBuild targets are fully activated during the build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.Speech.Onnx.Piper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" />
    <None Include="PACKAGE-LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- API documentation generation -->
  <PropertyGroup>
    <!-- Run API documentation generation only for this framework in multi-targeted builds -->
    <ApiDocsTargetFramework>net8.0</ApiDocsTargetFramework>
    <!-- Configuration-specific output so Debug and Release docs do not overwrite each other -->
    <ApiMarkOutputDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\apimark-docs</ApiMarkOutputDir>
    <!-- Pack generated API docs into the NuGet package under api/ -->
    <ApiMarkPackDocs>false</ApiMarkPackDocs>
    <ApiMarkPackDocs Condition="'$(TargetFramework)' == '$(ApiDocsTargetFramework)'">true</ApiMarkPackDocs>
    <!-- Disable for non-primary framework to avoid duplicate generation in multi-targeted builds -->
    <DisableApiMark Condition="'$(TargetFramework)' != '$(ApiDocsTargetFramework)'">true</DisableApiMark>
    <!-- Report (but do not yet fail the build on) any public API surface missing an XML doc
         <summary>, so gaps are visible before this is tightened to Error. -->
    <ApiMarkEnforceDocs Condition="'$(TargetFramework)' == '$(ApiDocsTargetFramework)'">Public</ApiMarkEnforceDocs>
    <ApiMarkEnforceDocsSeverity Condition="'$(TargetFramework)' == '$(ApiDocsTargetFramework)'">Warning</ApiMarkEnforceDocsSeverity>
    <ApiMarkLibraryDescription Condition="'$(TargetFramework)' == '$(ApiDocsTargetFramework)'">DemaConsulting.Speech.Onnx.Piper supplies a production, raw-ONNX-Runtime-backed Piper (VITS)
      LibriTTS-R English text-to-speech model for DemaConsulting.Speech: 904 speakers selected by number,
      with no bundled native inference engine and no espeak-ng.

      Start here: `catalog.AddPiperModels()`, an extension method on
      `DemaConsulting.Speech.ModelManagementSubsystem.SpeechModelCatalog` that registers this
      model so it appears in `Enumerate()` and can be downloaded/loaded exactly like any other
      catalog model.

      See the [README](https://github.com/demaconsulting/Speech/blob/main/README.md) and the
      [user guide](https://github.com/demaconsulting/Speech/blob/main/docs/user_guide/introduction.md)
      for a full walkthrough.</ApiMarkLibraryDescription>
  </PropertyGroup>

</Project>
