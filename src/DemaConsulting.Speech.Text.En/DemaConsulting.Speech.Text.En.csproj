<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DemaConsulting.Speech.Text.En</RootNamespace>
    <AssemblyName>DemaConsulting.Speech.Text.En</AssemblyName>

    <!-- NuGet Package Configuration -->
    <PackageId>DemaConsulting.Speech.Text.En</PackageId>
    <Version>0.0.0</Version>
    <Authors>DEMA Consulting</Authors>
    <Company>DEMA Consulting</Company>
    <Description>English text analysis for DemaConsulting.Speech (preview): an ITextAnalyzer that
      tags the words of a speech request with their Universal Dependencies part of speech
      (through the DemaConsulting.PartOfSpeech tagger), describes how abbreviations, symbols,
      apostrophes and initialisms are spoken as replacement-span annotations over the original
      text (with host-supplied pronunciation overrides that take precedence), supplies authoritative sentence boundaries, and
      marks which reading a heteronym such as record has (an embedded, trained model decides from the sentence
      context), for text-to-speech models that use
      sentence-level context. A model package
      returns an EnglishTextAnalyzer from ISynthesisModel.TextAnalyzer; the analysis reaches an
      annotation-aware synthesis backend as language-neutral annotations on each speech segment.
      Core DemaConsulting.Speech stays language-neutral and has no dependency on this package.</Description>
    <!-- A package carries a license expression or a license file, never both. This package names a
         file (SPDX MIT AND CC-BY-3.0-US: MIT code, with the embedded heteronym model provided under
         the terms of the license of the MASC-derived data it was trained on) so the license text,
         the data attribution and the dependency notice travel with it; the licenses of the
         DemaConsulting.PartOfSpeech package's embedded data are described, as a dependency notice,
         in THIRD-PARTY-NOTICES.md. See PACKAGE-LICENSE.md. -->
    <PackageLicenseFile>PACKAGE-LICENSE.md</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/demaconsulting/Speech</PackageProjectUrl>
    <RepositoryUrl>https://github.com/demaconsulting/Speech</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>speech;text-to-speech;tts;text-analysis;nlp;part-of-speech;pos-tagging;english;offline</PackageTags>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>DemaConsulting.Speech.Text.En</Title>
    <Product>DemaConsulting.Speech.Text.En</Product>

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- SBOM Configuration -->
    <GenerateSBOM>true</GenerateSBOM>
    <SBOMPackageName>$(PackageId)</SBOMPackageName>
    <SBOMPackageVersion>$(Version)</SBOMPackageVersion>
    <SBOMPackageSupplier>Organization: $(Company)</SBOMPackageSupplier>
  </PropertyGroup>

  <!-- Prerelease-only packing (TEMPORARY GUARD).
       DemaConsulting.PartOfSpeech is published only as 0.1.0-beta.N, and a stable package may not
       depend on a prerelease package (NuGet NU5104). The shared build and release workflows pack
       every packable project with one version (the PackageVersion property), which may be
       stable (for example 1.0.0), so this project is packable only when the package version carries
       a prerelease label. A stable version skips this project (the other packages still pack); a
       prerelease such as 1.0.0-beta.1 packs it. The effective version is PackageVersion when given
       (as the workflows do) and Version otherwise; SemVer build metadata after '+' is ignored, so
       only a hyphen in the version proper counts. The local default Version of 0.0.0 is stable, so
       a plain local pack skips this project unless a prerelease version is passed.
       REMOVE this guard (and its requirement SpeechTextEn-Packaging-PrereleaseOnly) once
       DemaConsulting.PartOfSpeech ships a stable release and the pin below is moved to it. -->
  <PropertyGroup>
    <TextEnEffectiveVersion>$(Version)</TextEnEffectiveVersion>
    <TextEnEffectiveVersion Condition="'$(PackageVersion)' != ''">$(PackageVersion)</TextEnEffectiveVersion>
    <TextEnVersionCore>$(TextEnEffectiveVersion.Split('+')[0])</TextEnVersionCore>
    <IsPackable>false</IsPackable>
    <IsPackable Condition="$(TextEnVersionCore.Contains('-'))">true</IsPackable>
  </PropertyGroup>

  <!-- Build Tool Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.13" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
    <PackageReference Include="DemaConsulting.ApiMark.MSBuild" Version="0.5.12" PrivateAssets="All" />
  </ItemGroup>

  <!-- Runtime Dependencies -->
  <ItemGroup>
    <!-- DemaConsulting.PartOfSpeech is a pre-release package (only 0.1.0-beta.N versions are
         published). It is pinned to one exact version with the NuGet exact-range notation so a
         restore can never float to a different build of the tagger and silently change the
         analysis. All use of it is confined to the internal PartOfSpeechAdapter; no PartOfSpeech
         type appears in this package's public API. Because a stable package may not depend on a
         pre-release package (NU5104), this package is packed only for a pre-release version (see
         the prerelease-only packing guard above); a stable release of it must wait until
         DemaConsulting.PartOfSpeech publishes a stable version. -->
    <PackageReference Include="DemaConsulting.PartOfSpeech" Version="[0.1.0-beta.5]" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\DemaConsulting.Speech\DemaConsulting.Speech.csproj" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <!-- Analyzer packages use child-element form to configure both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" prevents these build-time analyzers from becoming transitive dependencies
           in packages that consume this library.
         - IncludeAssets lists all asset types (including 'analyzers' and 'buildtransitive') to ensure
           Roslyn analyzers and MSBuild targets are fully activated during the build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.Speech.Text.En.Tests" />
    <!-- The non-shipped trainer tool (and its tests) train and evaluate the heteronym model with this
         library's own feature extractor, scoring and model format instead of a copy of them. -->
    <InternalsVisibleTo Include="DemaConsulting.Speech.Text.En.Trainer" />
    <InternalsVisibleTo Include="DemaConsulting.Speech.Text.En.Trainer.Tests" />
  </ItemGroup>

  <!-- The two small lexicon tables written by DEMA Consulting (abbreviations and initialisms) the
       normalizer reads at run time; manifest names are DemaConsulting.Speech.Text.En.Resources.*.tsv -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\*.tsv" />
  </ItemGroup>

  <!-- The heteronym reading inventory (CC0-1.0 tables written by DEMA Consulting), embedded by link from
       data/text-en so the data folder stays the single source of truth (MANIFEST.tsv pins both files).
       The logical names are fixed and do not clash with the Resources\*.tsv names above. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\text-en\readings.tsv" LogicalName="DemaConsulting.Speech.Text.En.Resources.readings.tsv" />
    <EmbeddedResource Include="..\..\data\text-en\forms.tsv" LogicalName="DemaConsulting.Speech.Text.En.Resources.forms.tsv" />
  </ItemGroup>

  <!-- The trained heteronym model, written by the non-shipped trainer tool (train) from the training and
       development data in data/text-en and verified against tools/DemaConsulting.Speech.Text.En.Trainer/
       training.json (the trainer's check command). The resource name is the one HeteronymModelProvider.Embedded reads.
       The file is required: a build without it fails instead of silently shipping no model. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\heteronyms.bin" LogicalName="DemaConsulting.Speech.Text.En.Resources.heteronyms.bin" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" />
    <None Include="PACKAGE-LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- API documentation generation -->
  <PropertyGroup>
    <!-- Run API documentation generation only for this framework in multi-targeted builds -->
    <ApiDocsTargetFramework>net8.0</ApiDocsTargetFramework>
    <!-- Configuration-specific output so Debug and Release docs do not overwrite each other -->
    <ApiMarkOutputDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\apimark-docs</ApiMarkOutputDir>
    <!-- Pack generated API docs into the NuGet package under api/ -->
    <ApiMarkPackDocs>false</ApiMarkPackDocs>
    <ApiMarkPackDocs Condition="'$(TargetFramework)' == '$(ApiDocsTargetFramework)'">true</ApiMarkPackDocs>
    <!-- Disable for non-primary framework to avoid duplicate generation in multi-targeted builds -->
    <DisableApiMark Condition="'$(TargetFramework)' != '$(ApiDocsTargetFramework)'">true</DisableApiMark>
    <!-- Report (but do not yet fail the build on) any public API surface missing an XML doc
         <summary>, so gaps are visible before this is tightened to Error. -->
    <ApiMarkEnforceDocs Condition="'$(TargetFramework)' == '$(ApiDocsTargetFramework)'">Public</ApiMarkEnforceDocs>
    <ApiMarkEnforceDocsSeverity Condition="'$(TargetFramework)' == '$(ApiDocsTargetFramework)'">Warning</ApiMarkEnforceDocsSeverity>
    <ApiMarkLibraryDescription Condition="'$(TargetFramework)' == '$(ApiDocsTargetFramework)'">DemaConsulting.Speech.Text.En (preview) supplies English text analysis for DemaConsulting.Speech:
      part-of-speech tagging, normalization of abbreviations, symbols, apostrophes and initialisms,
      and authoritative sentence boundaries for text-to-speech models.

      Start here: `new EnglishTextAnalyzer()`, an `ITextAnalyzer` that a model package returns from
      `ISynthesisModel.TextAnalyzer`. Its `en.upos` and `en.norm` annotations (see `TextEnAnnotations`)
      reach an annotation-aware synthesis backend on each speech segment.

      See the [README](https://github.com/demaconsulting/Speech/blob/main/README.md) and the
      [user guide](https://github.com/demaconsulting/Speech/blob/main/docs/user_guide/introduction.md)
      for more.</ApiMarkLibraryDescription>
  </PropertyGroup>

</Project>
