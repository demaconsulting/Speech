<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Required by [LibraryImport] source-generated P/Invoke stubs (PortAudioNativeMethods) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>DemaConsulting.Speech</RootNamespace>
    <AssemblyName>DemaConsulting.Speech</AssemblyName>

    <!-- NuGet Package Configuration -->
    <PackageId>DemaConsulting.Speech</PackageId>
    <Version>0.0.0</Version>
    <Authors>DEMA Consulting</Authors>
    <Company>DEMA Consulting</Company>
    <Description>Cross-platform .NET library providing local, offline speech-to-text and
      text-to-speech services for desktop applications. Start here: SpeechModelCatalog,
      AudioDeviceFactory, SpeechRecognizerFactory and SpeechSynthesizerFactory. None of these
      throw for an ordinary machine state such as missing hardware or an uninstalled model; check
      IsAvailable instead. See the README and user guide for a full walkthrough.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/demaconsulting/Speech</PackageProjectUrl>
    <RepositoryUrl>https://github.com/demaconsulting/Speech</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>speech;speech-to-text;text-to-speech;stt;tts;offline;audio</PackageTags>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>DemaConsulting.Speech</Title>
    <Product>DemaConsulting.Speech</Product>

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- Polyfill Configuration -->
    <PolyArgumentExceptions>true</PolyArgumentExceptions>

    <!-- SBOM Configuration -->
    <GenerateSBOM>true</GenerateSBOM>
    <SBOMPackageName>$(PackageId)</SBOMPackageName>
    <SBOMPackageVersion>$(Version)</SBOMPackageVersion>
    <SBOMPackageSupplier>Organization: $(Company)</SBOMPackageSupplier>
  </PropertyGroup>

  <!-- Build Tool Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.12" PrivateAssets="All" />
    <PackageReference Include="Polyfill" Version="11.4.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
    <PackageReference Include="DemaConsulting.ApiMark.MSBuild" Version="0.5.1" PrivateAssets="All" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
    <!-- Managed sherpa-onnx API only. The matching org.k2fsa.sherpa.onnx.runtime.{RID} native
         package is deliberately NOT referenced here: this library does NOT bundle sherpa-onnx
         native runtime packages; the consuming application adds the runtime package(s) for its
         own target RID(s). -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <!-- The BCL has no BZip2 decoder. SharpCompress provides the .tar.bz2 extraction used by
         TarBz2ArchiveExtractor to unpack sherpa-onnx model archives (e.g. the streaming
         Zipformer/Nemotron recognition models) during model install. -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <!-- Provides System.Numerics.Tensors.TensorPrimitives, used to vectorize the hottest
         per-sample audio DSP loops (FIR filtering, volume scaling, PCM sample-format
         conversion) instead of hand-rolled scalar loops. -->
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.12" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <!-- Analyzer packages use child-element form to configure both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" prevents these build-time analyzers from becoming transitive dependencies
           in packages that consume this library.
         - IncludeAssets lists all asset types (including 'analyzers' and 'buildtransitive') to ensure
           Roslyn analyzers and MSBuild targets are fully activated during the build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.34.0.3385">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.Speech.Tests" />
    <InternalsVisibleTo Include="DemaConsulting.Speech.Demo.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Independence Verification Configuration -->
  <PropertyGroup>
    <!-- Semicolon-separated list of package-identity prefixes this library must never
         reference. These are interface/UI/hosting-layer packages (Avalonia, ASP.NET Core,
         WinForms/WPF, MAUI) that would tie a general-purpose offline speech library to a
         specific application shell, breaking its "usable by any .NET host" promise. No such
         package is referenced yet - the list is seeded now so the check below is exercised
         and proven correct before any real dependency (e.g. a future demo application
         project) could accidentally add one. -->
    <SpeechDeniedPackagePrefixes>Avalonia;Microsoft.AspNetCore;Microsoft.WindowsDesktop;System.Windows.Forms;Microsoft.Maui</SpeechDeniedPackagePrefixes>
  </PropertyGroup>

  <!-- Carried forward from the reference implementation's VerifyLibraryIsIndependent pattern
       (enforcing this library's zero-project-reference and denylisted interface-layer package rule):
       fails the build if this library gains a ProjectReference to anything, or a
       PackageReference to a denylisted interface/UI-layer package, keeping the library
       independently publishable and safely consumable by any host application. -->
  <Target Name="VerifyLibraryIsIndependent" BeforeTargets="Build">
    <Error Condition="'@(ProjectReference)' != ''" Text="DemaConsulting.Speech must not have any ProjectReference (found: @(ProjectReference)). This library must remain independently publishable with zero project references." />

    <Error Condition="'@(PackageReference)' != '' and&#xA;                 ($([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Avalonia'))&#xA;                  or $([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Microsoft.AspNetCore'))&#xA;                  or $([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Microsoft.WindowsDesktop'))&#xA;                  or $([System.String]::Copy('%(PackageReference.Identity)').StartsWith('System.Windows.Forms'))&#xA;                  or $([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Microsoft.Maui')))" Text="Package '%(PackageReference.Identity)' is on the interface/UI-layer package deny-list ($(SpeechDeniedPackagePrefixes)) for DemaConsulting.Speech and must not be referenced." />
  </Target>

  <!-- API documentation generation -->
  <PropertyGroup>
    <!-- Run API documentation generation only for this framework in multi-targeted builds -->
    <ApiDocsTargetFramework>net8.0</ApiDocsTargetFramework>
    <!-- Configuration-specific output so Debug and Release docs do not overwrite each other -->
    <ApiMarkOutputDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\apimark-docs</ApiMarkOutputDir>
    <!-- Pack generated API docs into the NuGet package under api/ -->
    <ApiMarkPackDocs>false</ApiMarkPackDocs>
    <ApiMarkPackDocs Condition="'$(TargetFramework)' == '$(ApiDocsTargetFramework)'">true</ApiMarkPackDocs>
    <!-- Disable for non-primary framework to avoid duplicate generation in multi-targeted builds -->
    <DisableApiMark Condition="'$(TargetFramework)' != '$(ApiDocsTargetFramework)'">true</DisableApiMark>
    <!-- Report (but do not yet fail the build on) any public API surface missing an XML doc
         <summary>, so gaps are visible before this is tightened to Error. -->
    <ApiMarkEnforceDocs Condition="'$(TargetFramework)' == '$(ApiDocsTargetFramework)'">Public</ApiMarkEnforceDocs>
    <ApiMarkEnforceDocsSeverity Condition="'$(TargetFramework)' == '$(ApiDocsTargetFramework)'">Warning</ApiMarkEnforceDocsSeverity>
    <!-- Fuller "start here" intro shown at the top of the generated api.md, distinct from the
         shorter NuGet-listing <Description> above. Fixed in ApiMark 0.5.1 (previously this was
         silently ignored in favor of the compiled AssemblyDescriptionAttribute for .NET
         assemblies). Links are absolute GitHub URLs because api.md is packed into the NuGet
         package, which has no access to repository-relative paths. -->
    <ApiMarkLibraryDescription Condition="'$(TargetFramework)' == '$(ApiDocsTargetFramework)'">DemaConsulting.Speech is a cross-platform .NET library providing local, offline
      speech-to-text (STT) and text-to-speech (TTS) services for desktop applications.

      Start here: `SpeechModelCatalog` (enumerate/download STT/TTS models), `AudioDeviceFactory`
      (create capture/playback audio devices), `SpeechRecognizerFactory` (compose a speech
      recognizer from a model and capture device), and `SpeechSynthesizerFactory` (compose a
      speech synthesizer from a model and playback device). None of these throw for an ordinary
      machine state such as missing hardware or an uninstalled model; check `IsAvailable`
      instead.

      See the [README](https://github.com/demaconsulting/Speech/blob/main/README.md) and the
      [user guide](https://github.com/demaconsulting/Speech/blob/main/docs/user_guide/introduction.md)
      for a full walkthrough, including the inline Natural Language Audio Tags used for
      expressive synthesis.</ApiMarkLibraryDescription>
  </PropertyGroup>

</Project>
