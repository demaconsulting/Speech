<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:recognition="clr-namespace:DemaConsulting.Speech.Demo.RecognitionPanelSubsystem"
             x:Class="DemaConsulting.Speech.Demo.RecognitionPanelSubsystem.RecognitionPanelView"
             x:DataType="recognition:RecognitionPanelViewModel">

  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="Speech to Text" FontSize="18" FontWeight="SemiBold" />

    <TextBlock Grid.Row="1"
               Margin="0,8,0,0"
               TextWrapping="Wrap"
               IsVisible="{Binding !HasModels}"
               Text="{x:Static recognition:RecognitionPanelViewModel.NoModelsMessage}" />

    <ComboBox Grid.Row="2"
              Margin="0,8,0,0"
              ItemsSource="{Binding AvailableModels}"
              SelectedItem="{Binding SelectedModel}"
              IsVisible="{Binding HasModels}"
              IsEnabled="{Binding CanChangeModel}"
              DisplayMemberBinding="{Binding DisplayName}"
              Width="260"
              HorizontalAlignment="Left" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button Content="Start" Command="{Binding StartCommand}" />
      <Button Content="Stop" Command="{Binding StopCommand}" />
      <Button Content="Refresh" Command="{Binding RefreshCommand}" />
      <TextBlock Text="{Binding State}" VerticalAlignment="Center" />
    </StackPanel>

    <Border Grid.Row="4"
            Margin="0,8,0,0"
            BorderBrush="Gray"
            BorderThickness="1"
            Padding="8">
      <ScrollViewer>
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Finals}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Partial}" TextWrapping="Wrap" Opacity="0.6" FontStyle="Italic" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="5"
               Margin="0,4,0,0"
               TextWrapping="Wrap"
               IsVisible="{Binding HasStatusMessage}"
               Text="{Binding StatusMessage}"
               Foreground="IndianRed" />

  </Grid>

</UserControl>
