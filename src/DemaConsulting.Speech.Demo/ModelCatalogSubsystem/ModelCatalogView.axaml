<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DemaConsulting.Speech.Demo.ModelCatalogSubsystem"
             x:Class="DemaConsulting.Speech.Demo.ModelCatalogSubsystem.ModelCatalogView"
             x:DataType="models:ModelCatalogViewModel">

  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

    <TextBlock Grid.Row="0" Text="Model Catalog" FontSize="18" FontWeight="SemiBold" />

    <Border Grid.Row="1"
            Margin="0,8,0,0"
            Padding="8"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="4">
      <StackPanel Spacing="4">
        <TextBlock Text="Download mirror" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap"
                   Opacity="0.7"
                   Text="Redirect model downloads to an internal mirror instead of each model's own public URI - useful when the public host is blocked. Leave the mirror URL blank and apply to revert to public downloads." />

        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Mirror URL" VerticalAlignment="Center" Margin="0,0,8,4" />
          <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                    PlaceholderText="https://mirror.example.com" Text="{Binding MirrorUrl}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="User" VerticalAlignment="Center" Margin="0,0,8,4" />
          <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" Text="{Binding MirrorUser}" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,0,8,4" />
          <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" PasswordChar="*" Text="{Binding MirrorPassword}" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Bearer Token" VerticalAlignment="Center" Margin="0,0,8,4" />
          <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" PasswordChar="*" Text="{Binding MirrorBearerToken}" />
        </Grid>

        <Button Content="Apply mirror" Command="{Binding ApplyMirrorCommand}" HorizontalAlignment="Left" />

        <TextBlock Text="{Binding MirrorStatusMessage}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding MirrorHasError}"
                   Foreground="IndianRed" />
        <TextBlock Text="{Binding MirrorStatusMessage}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding MirrorAppliedSuccessfully}"
                   Opacity="0.7" />
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="2"
               Margin="0,8,0,8"
               TextWrapping="Wrap"
               IsVisible="{Binding IsCatalogEmpty}"
               Text="{x:Static models:ModelCatalogViewModel.EmptyCatalogMessage}" />

    <ListBox Grid.Row="3"
             ItemsSource="{Binding Models}"
             SelectedItem="{Binding SelectedModel}"
             IsVisible="{Binding HasModels}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="models:ModelListItemViewModel">
          <StackPanel Spacing="4" Margin="0,4">
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Id}" Opacity="0.6" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding StatusText}" />
              <TextBlock Text="{Binding Role}" Opacity="0.6" />
            </StackPanel>
            <ProgressBar Minimum="0" Maximum="1"
                         Value="{Binding ProgressFraction}"
                         IsVisible="{Binding IsDownloading}" />
            <TextBlock Text="{Binding FailureMessage}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasFailureMessage}"
                       Foreground="IndianRed" />
            <Button Content="Download"
                    IsEnabled="{Binding CanDownload}"
                    Command="{Binding $parent[ListBox].((models:ModelCatalogViewModel)DataContext).DownloadCommand}"
                    CommandParameter="{Binding}"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Grid.Row="4"
            Margin="0,8,0,0"
            Padding="8"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="4"
            IsVisible="{Binding HasVoicePacks}">
      <StackPanel Spacing="4">
        <TextBlock Text="Reference voices" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap"
                   Opacity="0.7"
                   Text="Voice packs add reference voices that voice-cloning text-to-speech models (such as Chatterbox Turbo) can imitate. Installing or removing a pack refreshes the voice dropdown in the Text to Speech panel." />
        <TextBlock TextWrapping="Wrap"
                   FontWeight="SemiBold"
                   Text="{Binding VoiceConsentNotice}" />
        <TextBlock TextWrapping="Wrap" Opacity="0.7">
          <Run Text="Your own .wav/.flac voices: place them in" />
          <Run Text="{Binding UserVoicesDirectory}" />
          <Run Text="and refresh the catalog." />
        </TextBlock>

        <ItemsControl ItemsSource="{Binding VoicePacks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:ReferenceVoicePackListItemViewModel">
              <StackPanel Spacing="4" Margin="0,4">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Id}" Opacity="0.6" />
                <TextBlock Text="{Binding LicenseText}" Opacity="0.6" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding StatusText}" />
                  <TextBlock Text="{Binding SizeText}" Opacity="0.6" />
                  <TextBlock Text="{Binding InstalledSizeText}" Opacity="0.6" />
                </StackPanel>
                <CheckBox Content="Include emotion variants (13 moods per speaker; about 530 MiB more on disk, same download)"
                          IsChecked="{Binding IncludeEmotions}"
                          IsVisible="{Binding ShowEmotionOption}" />
                <ProgressBar Minimum="0" Maximum="1"
                             Value="{Binding ProgressFraction}"
                             IsVisible="{Binding IsInstalling}" />
                <TextBlock Text="{Binding FailureMessage}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasFailureMessage}"
                           Foreground="IndianRed" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{Binding InstallButtonText}"
                          IsEnabled="{Binding CanInstall}"
                          Command="{Binding $parent[ItemsControl].((models:ModelCatalogViewModel)DataContext).InstallVoicePackCommand}"
                          CommandParameter="{Binding}" />
                  <Button Content="Remove"
                          IsEnabled="{Binding CanRemove}"
                          Command="{Binding $parent[ItemsControl].((models:ModelCatalogViewModel)DataContext).RemoveVoicePackCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Button Grid.Row="5"
            Margin="0,8,0,0"
            Content="Refresh catalog"
            Command="{Binding RefreshCommand}"
            HorizontalAlignment="Left" />

  </Grid>

</UserControl>
