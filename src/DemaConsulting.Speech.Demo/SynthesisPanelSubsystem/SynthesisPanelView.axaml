<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:synthesis="clr-namespace:DemaConsulting.Speech.Demo.SynthesisPanelSubsystem"
             xmlns:settings="clr-namespace:DemaConsulting.Speech.Demo.ModelSettingsSubsystem"
             x:Class="DemaConsulting.Speech.Demo.SynthesisPanelSubsystem.SynthesisPanelView"
             x:DataType="synthesis:SynthesisPanelViewModel">

  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">

    <TextBlock Grid.Row="0" Text="Text to Speech" FontSize="18" FontWeight="SemiBold" />

    <TextBlock Grid.Row="1"
               Margin="0,8,0,0"
               TextWrapping="Wrap"
               IsVisible="{Binding !HasModels}"
               Text="{x:Static synthesis:SynthesisPanelViewModel.NoModelsMessage}" />

    <ComboBox Grid.Row="2"
              Margin="0,8,0,0"
              ItemsSource="{Binding AvailableModels}"
              SelectedItem="{Binding SelectedModel}"
              IsVisible="{Binding HasModels}"
              IsEnabled="{Binding CanChangeModel}"
              DisplayMemberBinding="{Binding DisplayName}"
              Width="260"
              HorizontalAlignment="Left" />

    <TextBox Grid.Row="3"
             Margin="0,8,0,0"
             Text="{Binding Text}"
             Watermark="Type text to speak. Try an inline tag, e.g. [whispers] or [short pause]."
             AcceptsReturn="True"
             TextWrapping="Wrap"
             MinHeight="120" />

    <ItemsControl Grid.Row="4"
                  Margin="0,8,0,0"
                  ItemsSource="{Binding ExampleTagHints}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" Margin="0,0,8,4" Opacity="0.7" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button Content="Play" Command="{Binding PlayCommand}" />
      <Button Content="Stop" Command="{Binding StopCommand}" />
      <Button Content="Refresh" Command="{Binding RefreshCommand}" />
      <TextBlock Text="{Binding State}" VerticalAlignment="Center" />
    </StackPanel>

    <TextBlock Grid.Row="6"
               Margin="0,4,0,0"
               TextWrapping="Wrap"
               IsVisible="{Binding HasStatusMessage}"
               Text="{Binding StatusMessage}"
               Foreground="IndianRed" />

    <Border Grid.Row="7" Margin="0,8,0,0" IsEnabled="{Binding CanChangeModel}">
      <settings:ModelSettingsView DataContext="{Binding Settings}" />
    </Border>

  </Grid>

</UserControl>
