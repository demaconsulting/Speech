<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DemaConsulting.Speech.Sherpa</RootNamespace>
    <AssemblyName>DemaConsulting.Speech.Sherpa</AssemblyName>

    <!-- NuGet Package Configuration -->
    <PackageId>DemaConsulting.Speech.Sherpa</PackageId>
    <Version>0.0.0</Version>
    <Authors>DEMA Consulting</Authors>
    <Company>DEMA Consulting</Company>
    <Description>Sherpa-onnx-backed speech models for DemaConsulting.Speech: two streaming
      speech-to-text models and two offline text-to-speech models, installed into a
      SpeechModelCatalog via the AddSherpaModels() extension method. Reference this package
      alongside DemaConsulting.Speech to get working, production models out of the box; core
      DemaConsulting.Speech itself ships with zero built-in models and has no dependency on
      sherpa-onnx or SharpCompress.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/demaconsulting/Speech</PackageProjectUrl>
    <RepositoryUrl>https://github.com/demaconsulting/Speech</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>speech;speech-to-text;text-to-speech;stt;tts;offline;audio;sherpa-onnx</PackageTags>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>DemaConsulting.Speech.Sherpa</Title>
    <Product>DemaConsulting.Speech.Sherpa</Product>

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- SBOM Configuration -->
    <GenerateSBOM>true</GenerateSBOM>
    <SBOMPackageName>$(PackageId)</SBOMPackageName>
    <SBOMPackageVersion>$(Version)</SBOMPackageVersion>
    <SBOMPackageSupplier>Organization: $(Company)</SBOMPackageSupplier>
  </PropertyGroup>

  <!-- Build Tool Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.13" PrivateAssets="All" />
    <!-- Deliberately NOT referencing Polyfill here (unlike DemaConsulting.Speech): this project's
         code does not use any API that needs polyfilling, and because DemaConsulting.Speech
         grants this project InternalsVisibleTo, a second, independent copy of Polyfill's
         internal extension members would become visible here too and collide
         (CS0121 "ambiguous call") with the identical members already compiled into
         DemaConsulting.Speech's own reference assembly. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
    <PackageReference Include="DemaConsulting.ApiMark.MSBuild" Version="0.5.3" PrivateAssets="All" />
    <!-- Managed sherpa-onnx API only. The matching org.k2fsa.sherpa.onnx.runtime.{RID} native
         package is deliberately NOT referenced here: this package does NOT bundle sherpa-onnx
         native runtime packages; the consuming application adds the runtime package(s) for its
         own target RID(s). -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <!-- The BCL has no BZip2 decoder. SharpCompress provides the .tar.bz2 extraction used by
         TarBz2ArchiveExtractor to unpack sherpa-onnx model archives (e.g. the streaming
         Zipformer/Nemotron recognition models) during model install. -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\DemaConsulting.Speech\DemaConsulting.Speech.csproj" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <!-- Analyzer packages use child-element form to configure both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" prevents these build-time analyzers from becoming transitive dependencies
           in packages that consume this library.
         - IncludeAssets lists all asset types (including 'analyzers' and 'buildtransitive') to ensure
           Roslyn analyzers and MSBuild targets are fully activated during the build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.Speech.Sherpa.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- API documentation generation -->
  <PropertyGroup>
    <!-- Run API documentation generation only for this framework in multi-targeted builds -->
    <ApiDocsTargetFramework>net8.0</ApiDocsTargetFramework>
    <!-- Configuration-specific output so Debug and Release docs do not overwrite each other -->
    <ApiMarkOutputDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\apimark-docs</ApiMarkOutputDir>
    <!-- Pack generated API docs into the NuGet package under api/ -->
    <ApiMarkPackDocs>false</ApiMarkPackDocs>
    <ApiMarkPackDocs Condition="'$(TargetFramework)' == '$(ApiDocsTargetFramework)'">true</ApiMarkPackDocs>
    <!-- Disable for non-primary framework to avoid duplicate generation in multi-targeted builds -->
    <DisableApiMark Condition="'$(TargetFramework)' != '$(ApiDocsTargetFramework)'">true</DisableApiMark>
    <!-- Report (but do not yet fail the build on) any public API surface missing an XML doc
         <summary>, so gaps are visible before this is tightened to Error. -->
    <ApiMarkEnforceDocs Condition="'$(TargetFramework)' == '$(ApiDocsTargetFramework)'">Public</ApiMarkEnforceDocs>
    <ApiMarkEnforceDocsSeverity Condition="'$(TargetFramework)' == '$(ApiDocsTargetFramework)'">Warning</ApiMarkEnforceDocsSeverity>
    <ApiMarkLibraryDescription Condition="'$(TargetFramework)' == '$(ApiDocsTargetFramework)'">DemaConsulting.Speech.Sherpa supplies the sherpa-onnx-backed production models for
      DemaConsulting.Speech: two streaming speech-to-text models (Zipformer, Nemotron) and two
      offline text-to-speech models (VITS/Piper LibriTTS-R, Kokoro).

      Start here: `catalog.AddSherpaModels()`, an extension method on
      `DemaConsulting.Speech.ModelManagementSubsystem.SpeechModelCatalog` that registers all four
      models so they appear in `Enumerate()` and can be downloaded/loaded exactly like any other
      catalog model.

      See the [README](https://github.com/demaconsulting/Speech/blob/main/README.md) and the
      [user guide](https://github.com/demaconsulting/Speech/blob/main/docs/user_guide/introduction.md)
      for a full walkthrough.</ApiMarkLibraryDescription>
  </PropertyGroup>

</Project>
