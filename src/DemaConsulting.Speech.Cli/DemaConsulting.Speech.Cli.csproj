<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DemaConsulting.Speech.Cli</RootNamespace>
    <AssemblyName>DemaConsulting.Speech.Cli</AssemblyName>

    <!-- NuGet Tool Package Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>speech-cli</ToolCommandName>
    <PackageId>DemaConsulting.Speech.Cli</PackageId>
    <Version>0.0.0</Version>
    <Authors>DEMA Consulting</Authors>
    <Company>DEMA Consulting</Company>
    <Description>Command-line tool for the DemaConsulting.Speech local, offline speech-to-text
      and text-to-speech library: manage models, inspect audio devices, and run synthesis and
      recognition from the command line.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/demaconsulting/Speech</PackageProjectUrl>
    <RepositoryUrl>https://github.com/demaconsulting/Speech</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>speech;speech-to-text;text-to-speech;stt;tts;offline;audio;cli;dotnet-tool</PackageTags>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>DemaConsulting.Speech.Cli</Title>
    <Product>DemaConsulting.Speech.Cli</Product>

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- SBOM Configuration -->
    <GenerateSBOM>true</GenerateSBOM>
    <SBOMPackageName>$(PackageId)</SBOMPackageName>
    <SBOMPackageVersion>$(Version)</SBOMPackageVersion>
    <SBOMPackageSupplier>Organization: $(Company)</SBOMPackageSupplier>
  </PropertyGroup>

  <!-- Runtime Dependencies -->
  <ItemGroup>
    <PackageReference Include="DemaConsulting.TestResults" Version="1.10.0" />
  </ItemGroup>

  <!-- Build Tool Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.13" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
    <PackageReference Include="Polyfill" Version="11.4.5" PrivateAssets="All" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <!-- Analyzer packages use child-element form to configure both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" prevents these build-time analyzers from becoming transitive dependencies
           in packages that consume this tool.
         - IncludeAssets lists all asset types (including 'analyzers' and 'buildtransitive') to ensure
           Roslyn analyzers and MSBuild targets are fully activated during the build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\DemaConsulting.Speech\DemaConsulting.Speech.csproj" />
    <!-- ONNX Runtime pairing. sherpa-onnx ships its own native onnxruntime 1.28.2 (same file name,
         onnxruntime.dll / libonnxruntime.so) and its C API is linked against that library's versioned
         symbols (Linux: VERS_1.28.2), so Microsoft's native copy must NOT replace it (on Linux sherpa
         then fails to load: "version 'VERS_1.28.2' not found"). Native assets are therefore excluded and
         sherpa's 1.28.2 is the only onnxruntime in the process. The managed API used by the raw-ONNX
         models (Kokoro, Piper, Nemotron, Chatterbox) must then not be newer than that native library
         (a 1.31.x managed API fails with "API version [31] is not available"), so it is pinned to 1.28.0,
         the 1.28 release of Microsoft.ML.OnnxRuntime. Keep this version equal to the ONNX Runtime
         bundled with the org.k2fsa.sherpa.onnx.runtime.* version in use; the doctor command tests
         fail when the pairing drifts. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" ExcludeAssets="native" />

    <ProjectReference Include="..\DemaConsulting.Speech.Onnx.ChatterboxTurbo\DemaConsulting.Speech.Onnx.ChatterboxTurbo.csproj" />
    <ProjectReference Include="..\DemaConsulting.Speech.Onnx.Kokoro\DemaConsulting.Speech.Onnx.Kokoro.csproj" />
    <ProjectReference Include="..\DemaConsulting.Speech.Onnx.Piper\DemaConsulting.Speech.Onnx.Piper.csproj" />
    <ProjectReference Include="..\DemaConsulting.Speech.Onnx.NemotronStt\DemaConsulting.Speech.Onnx.NemotronStt.csproj" />
    <ProjectReference Include="..\DemaConsulting.Speech.Sherpa\DemaConsulting.Speech.Sherpa.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.Speech.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
